1+c.phase)*.025,anchorY:1,alpha:night?.6:1,shadow:6})}}
function updateFood(dt,now){for(const f of food){f.vy=Math.min(59,f.vy+5*dt);f.x+=(f.vx+Math.sin(now*.003+f.phase)*9)*dt;f.y+=f.vy*dt;if(f.y>H-70)f.dead=true;ctx.save();ctx.translate(f.x,f.y);ctx.rotate(now*.0014+f.phase);ctx.fillStyle='#f7d485';ctx.shadowColor='#fff0ab';ctx.shadowBlur=5;ctx.beginPath();ctx.roundRect(-f.r,-f.r*.42,f.r*2,f.r*.84,2);ctx.fill();ctx.restore()}for(let i=food.length-1;i>=0;i--)if(food[i].dead)food.splice(i,1)}
function updateBubbles(dt,now){if(Math.random()<dt*8.5*cfg.bubbleRate)bubbles.push({x:rand(8,W-8),y:H+18,r:rand(5,16),vy:rand(24,65),phase:rand(0,TAU),style:choice(['effects/bubble-soft','effects/bubble-outline','effects/bubble-blue']),alpha:rand(.22,.62)});for(const b of bubbles){b.y-=b.vy*dt*(night?.68:1);b.x+=Math.sin(now*.0017+b.phase+b.y*.012)*12*dt;const pulse=1+Math.sin(now*.004+b.phase)*.08;drawSprite(b.style,b.x,b.y,b.r*2*pulse,{rotation:Math.sin(now*.001+b.phase)*.2,alpha:b.alpha*(night?.55:1)});if(b.y<35&&Math.random()<dt*1.8)playEffect('bubble',.035)}for(let i=bubbles.length-1;i>=0;i--)if(bubbles[i].y<-30)bubbles.splice(i,1)}
function drawVignette(){const g=ctx.createRadialGradient(W*.5,H*.42,Math.min(W,H)*.15,W*.5,H*.45,Math.max(W,H)*.72);g.addColorStop(.55,'rgba(0,8,18,0)');g.addColorStop(1,night?'rgba(0,2,9,.72)':'rgba(0,8,18,.38)');ctx.fillStyle=g;ctx.fillRect(0,0,W,H)}
function animate(now){const dt=Math.min((now-last)/1000,.034);last=now;elapsed+=dt;drawBackground(now);drawSeabed(now);drawPlants(now);drawDecor();drawCritters(dt,now);updateFood(dt,now);for(const f of fish)f.update(dt,now);for(const f of fish)f.draw(now);updateBubbles(dt,now);drawVignette();frameCount++;if(now-fpsClock>600){$('#fps').textContent=Math.round(frameCount*1000/(now-fpsClock));frameCount=0;fpsClock=now}requestAnimationFrame(animate)}
function unlockAudio(){if(audioUnlocked)return;audioUnlocked=true;for(const a of Object.values(audio)){if(!a)continue;a.volume=0;const p=a.play();if(p&&p.then)p.then(()=>{a.pause();a.currentTime=0;applyVolume();if(cfg.sound)audio.ambient.play().catch(()=>{})}).catch(()=>{})}}
function applyVolume(){const v=clamp(Number(cfg.volume)||0,0,1);if(audio.ambient)audio.ambient.volume=v*.55;if(audio.feed)audio.feed.volume=v*.78;if(audio.bubble)audio.bubble.volume=v*.38}
function playEffect(key,gain=1){if(!cfg.sound||!audioUnlocked||!audio[key])return;const a=audio[key].cloneNode();a.volume=clamp(cfg.volume*gain,0,1);a.play().catch(()=>{})}
function setSound(on){cfg.sound=!!on;unlockAudio();applyVolume();if(audio.ambient){if(cfg.sound)audio.ambient.play().catch(()=>{});else audio.ambient.pause()}$('#sound').checked=cfg.sound;$('#soundBtn').setAttribute('aria-pressed',String(cfg.sound));$('#soundBtn').textContent=cfg.sound?'🔊 Звук':'🔇 Звук';saveSettings()}
function saveSettings(){writeStore('living-aquarium-settings',cfg)}
function saveState(){saveSettings();writeStore('living-aquarium-state',{night,count:fish.filter(f=>!f.predator).length,species:fish.filter(f=>!f.predator).map(f=>f.spec)})}
function restoreState(){const s=readStore('living-aquarium-state'),count=clamp(Number(s.count)||8,1,34);fish.length=0;for(let i=0;i<count;i++)fish.push(new Fish({spec:Array.isArray(s.species)?Number(s.species[i])%species.length:undefined}));fish.push(new Fish({predator:true,x:W*.74,y:H*.38}));night=!!s.night;syncNight();updateCount()}
function resetAll(){cfg={...defaults};night=false;food.length=bubbles.length=0;localStorage.removeItem('living-aquarium-settings');localStorage.removeItem('living-aquarium-state');restoreState();syncControls();setSound(false);toast('↺ Аквариум возвращён к исходным настройкам')}
function syncNight(){$('#night').setAttribute('aria-pressed',String(night));$('#night').textContent=night?'☀️ День':'🌙 Ночь'}
function updateCount(){$('#fishCount').textContent=fish.filter(f=>!f.predator).length}
function syncControls(){for(const id of['separation','alignment','cohesion','speed','bubbleRate','volume'])$('#'+id).value=cfg[id];$('#sound').checked=cfg.sound;$('#caustics').checked=cfg.caustics;for(const [id,key,d] of [['sepOut','separation',1],['aliOut','alignment',1],['cohOut','cohesion',1],['speedOut','speed',2],['bubbleOut','bubbleRate',1]])$('#'+id).textContent=Number(cfg[key]).toFixed(d);$('#volumeOut').textContent=Math.round(cfg.volume*100)+'%'}
function toast(text){const t=$('#toast');t.textContent=text;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2300)}
canvas.addEventListener('pointerdown',e=>{unlockAudio();scare={x:e.clientX,y:e.clientY,until:performance.now()+2000};bubbleBurst(e.clientX,e.clientY,14)});
$('#feed').onclick=()=>{unlockAudio();feedFish()};$('#add').onclick=()=>addFish();$('#night').onclick=()=>{night=!night;syncNight();saveState()};$('#settings').onclick=()=>{const open=$('#panel').classList.toggle('open');$('#settings').setAttribute('aria-pressed',String(open))};$('#soundBtn').onclick=()=>setSound(!cfg.sound);$('#sound').onchange=e=>setSound(e.target.checked);$('#caustics').onchange=e=>{cfg.caustics=e.target.checked;saveSettings()};for(const id of['separation','alignment','cohesion','speed','bubbleRate','volume'])$('