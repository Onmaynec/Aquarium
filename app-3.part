sin(now*.011+this.phase)*.014;ctx.save();ctx.globalAlpha=.14;ctx.fillStyle='#00101c';ctx.beginPath();ctx.ellipse(this.x,this.y+this.size*.15,this.size*.35,this.size*.09,0,0,TAU);ctx.fill();ctx.restore();ctx.save();ctx.translate(this.x,this.y);ctx.scale(pulse,1/pulse);ctx.translate(-this.x,-this.y);drawSprite(sp.sprite,this.x,this.y,this.size,{flip,rotation:(flip?-1:1)*pitch+Math.sin(now*.008+this.phase)*.022,shadow:6});ctx.restore();if(this.eatTimer>0){ctx.fillStyle='rgba(255,242,176,.78)';ctx.beginPath();ctx.arc(this.x+(flip?-1:1)*this.size*.33,this.y+2,2.2,0,TAU);ctx.fill()}}
}
function wallForce(f,m){let x=0,y=0;if(f.x<m)x+=(m-f.x)/m*f.maxForce*1.7;if(f.x>W-m)x-=(f.x-(W-m))/m*f.maxForce*1.7;if(f.y<70+m)y+=(70+m-f.y)/m*f.maxForce*1.5;if(f.y>H-66-m)y-=(f.y-(H-66-m))/m*f.maxForce*1.8;return{x,y}}
function selectPrey(pred){let best=null,score=Infinity;for(const f of fish)if(!f.predator){const d=Math.hypot(f.x-pred.x,f.y-pred.y),edge=Math.min(f.x,W-f.x,f.y,H-f.y);const s=d+(edge<100?-40:0)+Math.hypot(f.vx,f.vy)*.2+Math.random()*35;if(s<score){score=s;best=f}}return best}
function nearestFood(f){let best=null,d2=Infinity;for(const q of food)if(!q.dead){const v=(q.x-f.x)**2+(q.y-f.y)**2;if(v<d2&&v<440*440){d2=v;best=q}}return best}
function safeSpawn(){const predator=fish.find(f=>f.predator);for(let i=0;i<25;i++){const q={x:rand(70,W-70),y:rand(90,H*.58)};if(!predator||Math.hypot(q.x-predator.x,q.y-predator.y)>330)return q}return{x:W*.12,y:H*.24}}
function respawnPrey(prey){const p=safeSpawn(),i=fish.indexOf(prey);bubbleBurst(prey.x,prey.y,18);fish[i]=new Fish({x:p.x,y:p.y,spec:prey.spec});toast('🦈 Барракуда поймала рыбку — новая уже появилась');updateCount();saveState()}
function addFish(show=true){const p=safeSpawn(),f=new Fish({x:p.x,y:p.y}),pred=fish.findIndex(x=>x.predator);pred<0?fish.push(f):fish.splice(pred,0,f);if(show)toast(`🐟 Добавлена: ${species[f.spec].name}`);updateCount();saveState()}
function feedFish(){for(let i=0;i<30;i++)food.push({x:rand(W*.14,W*.86),y:rand(-90,-8),vx:rand(-8,8),vy:rand(23,48),r:rand(2.2,4.5),phase:rand(0,TAU),dead:false});playEffect('feed',.75);toast('🍽️ Корм падает — стая меняет курс')}
function bubbleBurst(x,y,n=12){for(let i=0;i<n;i++)bubbles.push({x:x+rand(-14,14),y:y+rand(-8,8),r:rand(4,13),vy:rand(34,83),phase:rand(0,TAU),style:choice(['effects/bubble-soft','effects/bubble-outline','effects/bubble-blue']),alpha:rand(.35,.8)})}
function drawBackground(now){coverImage(assets.background,0,0,W,H,1);const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,night?'rgba(0,4,15,.76)':'rgba(0,38,69,.08)');g.addColorStop(.55,night?'rgba(0,8,22,.58)':'rgba(0,43,67,.08)');g.addColorStop(1,night?'rgba(0,3,11,.78)':'rgba(0,20,29,.34)');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
 if(cfg.caustics){ctx.save();ctx.globalCompositeOperation='screen';ctx.globalAlpha=night?.022:.085;ctx.beginPath();ctx.rect(0,0,W,H*.66);ctx.clip();const im=assets.caustics,size=Math.max(400,W*.46),off=(now*.012)%size;for(let y=-size;y<H*.62;y+=size*.88)for(let x=-size;x<W+size;x+=size*.9)ctx.drawImage(im,x+Math.sin(now*.00024+y)*70-off*.12,y+Math.cos(now*.00019+x)*26,size,size);ctx.restore();ctx.save();ctx.globalCompositeOperation='screen';for(let i=0;i<7;i++){const x=(i+.3)/7*W+Math.sin(now*.00034+i*1.7)*70,wide=70+i*9,grad=ctx.createLinearGradient(x,0,x+wide*1.2,H);grad.addColorStop(0,night?'rgba(120,210,255,.025)':'rgba(170,244,255,.13)');grad.addColorStop(1,'rgba(130,220,255,0)');ctx.fillStyle=grad;ctx.beginPath();ctx.moveTo(x-wide*.22,0);ctx.lineTo(x+wide*.22,0);ctx.lineTo(x+wide*1.3,H);ctx.lineTo(x+wide*.28,H);ctx.closePath();ctx.fill()}ctx.restore()}
 for(const m of motes){m.y-=m.z*.08;if(m.y<0)m.y=H;m.x+=Math.sin(now*.0005+m.p)*.025;ctx.fillStyle=`rgba(220,249,255,${night?.05:.09+m.z*.07})`;ctx.beginPath();ctx.arc(m.x,m.y,m.r,0,TAU);ctx.fill()}}
function drawSeabed(now){const top=H-93;ctx.save();ctx.beginPath();ctx.moveTo(0,top);for(let x=0;x<=W+35;x+=35)ctx.lineTo(x,top+noise1(x*.025)*11);ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.closePath();ctx.clip();sandPattern=sandPattern||ctx.createPattern(assets.sand,'repeat');ctx.fillStyle=sandPattern||'#b8a26f';ctx.globalAlpha=night?.32:.66;ctx.fillRect(0,top-20,W,H-top+20);const shade=ctx.createLinearGradient(0,top,0,H);shade.addColorStop(0,'rgba(30,72,70,.08)');shade.addColorStop(1,night?'rgba(0,4,9,.82)':'rgba(3,28,28,.5)');ctx.fillStyle=shade;ctx.globalAlpha=1;ctx.fillRect(0,top-20,W,H-top+20);ctx.restore()}
function drawDecor(){for(const d of decor){const scale=.72+d.depth*.44;drawSprite(d.key,d.x,d.y,d.w*scale,{rotation:d.rot,anchorY:1,alpha:night?.58:.9,shadow:8})}}
function drawPlants(now){for(const p of plants){const im=assets[p.key],sway=noise1(now*.00032+p.phase)*.11+Math.sin(now*.00055+p.phase)*.035,w=p.w*(.8+p.depth*.38),h=w*im.height/im.width;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.tilt+sway);ctx.transform(1,0,sway*.45,1,0,0);ctx.globalAlpha=night?.52:.78+p.depth*.18;ctx.drawImage(im,-w/2,-h,w,h);ctx.restore()}}
function drawCritters(dt,now){for(const c of critters){c.x+=c.dir*c.speed*dt*(night?.6:1);if(c.x<25||c.x>W-25)c.dir*=-1;const bob=Math.sin(now*.002+c.phase)*1.5;drawSprite(c.key,c.x,c.y+bob,c.w,{flip:c.dir<0,rotation:Math.sin(now*.00