
(()=>{'use strict';
const $=s=>document.querySelector(s),canvas=$('#aquarium'),ctx=canvas.getContext('2d',{alpha:false,desynchronized:true});
const TAU=Math.PI*2,clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),lerp=(a,b,t)=>a+(b-a)*t,rand=(a,b)=>Math.random()*(b-a)+a,choice=a=>a[Math.floor(Math.random()*a.length)];
let W=innerWidth,H=innerHeight,DPR=1,last=performance.now(),elapsed=0,night=false,scare=null,frameCount=0,fpsClock=performance.now(),toastTimer=0,manifest,assets={},sandPattern=null,audio={ambient:null,feed:null,bubble:null},audioUnlocked=false;
const defaults={separation:1.65,alignment:1.05,cohesion:.88,speed:1,bubbleRate:1,volume:.55,sound:false,caustics:true};
let cfg={...defaults,...readStore('living-aquarium-settings')};
const fish=[],food=[],bubbles=[],plants=[],decor=[],critters=[],motes=[];
const species=[
 {name:'рыба-клоун',sprite:'fish/clownfish',size:[78,102],speed:[58,82],turn:58},
 {name:'скалярия',sprite:'fish/angelfish',size:[70,92],speed:[45,66],turn:48},
 {name:'тропическая',sprite:'fish/tropical-fish',size:[80,106],speed:[60,86],turn:62},
 {name:'рыба-бабочка',sprite:'fish/butterflyfish',size:[77,100],speed:[52,76],turn:55},
 {name:'золотая рыбка',sprite:'fish/goldfish',size:[80,108],speed:[47,70],turn:50},
 {name:'голубой хирург',sprite:'fish/blue-tang',size:[82,108],speed:[58,84],turn:59}
];
const decorNames=['decor/coral-pink-branch','decor/coral-yellow-sponge','decor/coral-purple-fan','decor/coral-orange-garden','decor/coral-pink-bush','decor/coral-mixed-reef','decor/shell-pearl','decor/starfish','decor/conch-shell','decor/rock-blue','decor/rock-slab','decor/rock-mossy','decor/rock-coral'];
const plantNames=['laminaria-tall-wave','laminaria-ribbon-pair','laminaria-cluster','seagrass-fine','seagrass-sway','bush-round','bush-spiky','coral-branch','coral-fan','coral-candelabra'];
const critterNames=['creatures/golden-snail','creatures/pink-shrimp','creatures/orange-shrimp','creatures/pearl-shrimp','creatures/mint-snail'];
function readStore(k){try{return JSON.parse(localStorage.getItem(k)||'{}')}catch{return {}}}function writeStore(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch{}}
function hash(n){const x=Math.sin(n*127.1)*43758.5453123;return x-Math.floor(x)}function noise1(x){const i=Math.floor(x),f=x-i,u=f*f*(3-2*f);return lerp(hash(i),hash(i+1),u)*2-1}
function seeded(seed){let s=seed>>>0;return()=>((s=Math.imul(1664525,s)+1013904223>>>0)/4294967296)}
async function loadImage(src){return new Promise((resolve,reject)=>{const im=new Image();im.onload=()=>resolve(im);im.onerror=()=>reject(new Error('Не удалось загрузить '+src));im.src=src})}
async function loadAssets(){manifest=JSON.parse((await Promise.all(['assets/manifest-1.txt','assets/manifest-2.txt','assets/manifest-3.txt','assets/manifest-4.txt'].map(p=>fetch(p).then(r=>{if(!r.ok)throw new Error('manifest');return r.text()})))).join(''));const jobs=[];for(const [name,data] of Object.entries(manifest.atlases))jobs.push(loadImage(data.file).then(im=>assets[name]=im));for(const [name,src] of Object.entries(manifest.images))jobs.push(loadImage(src).then(im=>assets[name]=im));await Promise.all(jobs);audio.ambient=new Audio(manifest.audio.ambient);audio.ambient.loop=true;audio.ambient.preload='auto';audio.feed=new Audio(manifest.audio.feed);audio.feed.preload='auto';audio.bubble=new Audio(manifest.audio.bubble);audio.bubble.preload='auto';applyVolume();}
function spriteInfo(name){return manifest.sprites[name]}
function drawSprite(name,x,y,w,{flip=false,rotation=0,alpha=1,shadow=0,anchorY=.5}={}){const s=spriteInfo(name);if(!s)return;const im=assets[s.atlas],h=w*s.h/s.w;ctx.save();ctx.translate(x,y);ctx.rotate(rotation);if(flip)ctx.scale(-1,1);ctx.globalAlpha=alpha;if(shadow){ctx.shadowColor='rgba(0,0,0,.32)';ctx.shadowBlur=0;ctx.shadowOffsetY=2}ctx.drawImage(im,s.x,s.y,s.w,s.h,-w/2,-h*anchorY,w,h);ctx.restore();}
function coverImage(im,x,y,w,h,alpha=1){const r=Math.max(w/im.width,h/im.height),iw=im.width*r,ih=im.height*r;ctx.save();ctx.globalAlpha=alpha;ctx.drawImage(im,x+(w-iw)/2,y+(h-ih)/2,iw,ih);ctx.restore()}
function resize(){DPR=Math.min(devicePixelRatio||1,W<700?1.3:1.55);W=innerWidth;H=innerHeight;canvas.width=Math.round(W*DPR);canvas.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);buildScene();}
function buildScene(){const rng=seeded(84721);plants.length=decor.length=critters.length=motes.length=0;const bottom=H-22;
 const plantCount=clamp(Math.round(W/82),12,28);for(let i=0;i<plantCount;i++){const key=plantNames[i%plantNames.length];plants.push({key,x:(i+rng()*.7)/plantCount*W,y:bottom+rng()*8,w:42+rng()*48,phase:rng()*99,depth:rng(),tilt:(rng()-.5)*.12})}
 const decorCount=clamp(Math.round(W/165),7,15);for(let i=0;i<decorCount;i++){decor.push({key:decorNames[(i*5+2)%decorNames.length],x:(i+.25+rng()*.5)/decorCount*W,y:bottom+4,w:72+rng()*75,depth:rng(),rot:(rng()-.5)*.08})}
 for(let i=0;i<5;i++){critters.push({key:critterNames[i],x:(.08+i*.2+rng()*.07)*W,y:bottom-3-rng()*9,w:42+rng()*26,dir:rng()<.5?-1:1,speed:2+rng()*5,phase:rng()*TAU})}
 for(let i=0;i<72;i++)motes.push({x:rng()*W,y:rng()*H,r:.35+rng()*1.5,p:rng()*TAU,z:.25+rng()*.75});plants.sort((a,b)=>a.depth-b.depth);decor.sort((a,b)=>a.depth-b.depth)
