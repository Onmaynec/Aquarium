th-b.depth)
}
class Fish{
 constructor(o={}){this.predator=!!o.predator;this.spec=o.spec??Math.floor(rand(0,species.length));const sp=species[this.spec];this.x=o.x??rand(80,Math.max(81,W-80));this.y=o.y??rand(90,Math.max(91,H*.69));const a=rand(0,TAU),v=this.predator?52:rand(...sp.speed);this.vx=Math.cos(a)*v;this.vy=Math.sin(a)*v*.55;this.ax=0;this.ay=0;this.size=this.predator?148:rand(...sp.size);this.baseMax=this.predator?73:sp.speed[1];this.maxForce=this.predator?46:sp.turn;this.phase=rand(0,TAU);this.wander=rand(0,100);this.protected=1.4;this.eatTimer=0;this.targetFood=null;this.target=null;this.huntClock=rand(2,5);this.dash=0;this.rest=0;}
 steer(tx,ty,max=this.baseMax,force=this.maxForce){let dx=tx-this.x,dy=ty-this.y,d=Math.hypot(dx,dy)||1;let sx=dx/d*max-this.vx,sy=dy/d*max-this.vy,m=Math.hypot(sx,sy)||1,q=Math.min(force,m)/m;return{x:sx*q,y:sy*q}}
 update(dt,now){this.ax=this.ay=0;this.protected=Math.max(0,this.protected-dt);if(this.predator)this.updatePredator(dt,now);else this.updateSchool(dt,now);const nightFactor=night?.52:1,speedFactor=cfg.speed*nightFactor*(this.eatTimer>0?.22:1);this.vx+=this.ax*dt;this.vy+=this.ay*dt;let max=this.baseMax*speedFactor*(this.predator&&this.dash>0?1.55:1),m=Math.hypot(this.vx,this.vy)||1;if(m>max){this.vx=this.vx/m*max;this.vy=this.vy/m*max}const min=this.predator?18:12;if(m<min&&this.eatTimer<=0){this.vx=this.vx/m*min;this.vy=this.vy/m*min}this.x+=this.vx*dt;this.y+=this.vy*dt;const pad=this.predator?this.size*.5:this.size*.42;this.x=clamp(this.x,pad,W-pad);this.y=clamp(this.y,65+pad*.25,H-72-pad*.18);this.eatTimer=Math.max(0,this.eatTimer-dt);this.dash=Math.max(0,this.dash-dt);}
 updateSchool(dt,now){let count=0,ax=0,ay=0,cx=0,cy=0,sx=0,sy=0;for(const o of fish){if(o===this||o.predator)continue;let dx=o.x-this.x,dy=o.y-this.y,d2=dx*dx+dy*dy;if(d2<170*170){count++;ax+=o.vx;ay+=o.vy;cx+=o.x;cy+=o.y;if(d2<58*58&&d2>0){const d=Math.sqrt(d2),q=(1-d/58)/d;sx-=dx*q;sy-=dy*q}}}if(count){ax=ax/count-this.vx;ay=ay/count-this.vy;cx=cx/count-this.x;cy=cy/count-this.y;const cm=Math.hypot(cx,cy)||1,am=Math.hypot(ax,ay)||1,sm=Math.hypot(sx,sy)||1;this.ax+=ax/am*this.maxForce*.58*cfg.alignment;this.ay+=ay/am*this.maxForce*.58*cfg.alignment;this.ax+=cx/cm*this.maxForce*.43*cfg.cohesion;this.ay+=cy/cm*this.maxForce*.43*cfg.cohesion;if(sm>0){this.ax+=sx/sm*this.maxForce*1.05*cfg.separation;this.ay+=sy/sm*this.maxForce*1.05*cfg.separation}}
 const predator=fish.find(f=>f.predator);if(predator){let dx=this.x-predator.x,dy=this.y-predator.y,d=Math.hypot(dx,dy);if(d<265&&d>0){const q=(1-d/265)*720/d;this.ax+=dx*q;this.ay+=dy*q}}
 if(scare&&now<scare.until){let dx=this.x-scare.x,dy=this.y-scare.y,d=Math.hypot(dx,dy);if(d<360&&d>0){const q=(1-d/360)*1100/d;this.ax+=dx*q;this.ay+=dy*q}}
 if(!this.targetFood||this.targetFood.dead)this.targetFood=nearestFood(this);if(this.targetFood){const d=Math.hypot(this.targetFood.x-this.x,this.targetFood.y-this.y);const q=this.steer(this.targetFood.x,this.targetFood.y,this.baseMax*1.06,this.maxForce*1.2);this.ax+=q.x*1.45;this.ay+=q.y*1.45;if(d<this.size*.23+6){this.targetFood.dead=true;this.targetFood=null;this.eatTimer=.55;playEffect('bubble',.22)}}else{this.wander+=dt*.65;this.ax+=noise1(this.wander+this.phase)*8;this.ay+=noise1(this.wander+this.phase+40)*5}
 const wall=wallForce(this,85);this.ax+=wall.x;this.ay+=wall.y;}
 updatePredator(dt){this.huntClock-=dt;this.rest=Math.max(0,this.rest-dt);if(!this.target||this.target.predator||this.huntClock<=0){this.target=selectPrey(this);this.huntClock=rand(2.2,4.6)}if(this.rest>0){this.target=null;this.ax+=noise1(elapsed*.3+this.phase)*8;this.ay+=noise1(elapsed*.3+this.phase+20)*5}else if(this.target){const d=Math.hypot(this.target.x-this.x,this.target.y-this.y),lead=clamp(d/(this.baseMax+20),.2,1.6);const tx=this.target.x+this.target.vx*lead*.78,ty=this.target.y+this.target.vy*lead*.78,q=this.steer(tx,ty,this.baseMax+(this.dash>0?42:0),this.maxForce*(this.dash>0?1.45:1));this.ax+=q.x*1.2;this.ay+=q.y*1.2;if(d<230&&this.dash<=0&&Math.random()<dt*.85)this.dash=.9;if(d<this.size*.23+this.target.size*.2&&this.target.protected<=0){respawnPrey(this.target);this.target=null;this.rest=1.7;this.huntClock=2.5}}
 const wall=wallForce(this,115);this.ax+=wall.x*1.35;this.ay+=wall.y*1.35;$('#predatorState').textContent=this.rest>0?'отдых':this.dash>0?'рывок':'охота';}
 draw(now){if(this.predator){const pitch=clamp(Math.atan2(this.vy,Math.abs(this.vx)),-.42,.42),flip=this.vx<0;ctx.save();ctx.globalAlpha=.18;ctx.fillStyle='#00101c';ctx.beginPath();ctx.ellipse(this.x,this.y+17,this.size*.47,this.size*.12,0,0,TAU);ctx.fill();ctx.restore();drawSprite('fish/barracuda',this.x,this.y,this.size,{flip,rotation:(flip?-1:1)*pitch+Math.sin(now*.009+this.phase)*.018,shadow:9});if(this.dash>0){ctx.save();ctx.globalCompositeOperation='screen';ctx.globalAlpha=this.dash*.16;ctx.strokeStyle='#9eeeff';ctx.lineWidth=3;for(let i=0;i<3;i++){ctx.beginPath();ctx.moveTo(this.x-(flip?-1:1)*(this.size*.42+i*18),this.y-8+i*7);ctx.lineTo(this.x-(flip?-1:1)*(this.size*.8+i*27),this.y-8+i*7);ctx.stroke()}ctx.restore()}return}
 const sp=species[this.spec],flip=this.vx<0,pitch=clamp(Math.atan2(this.vy,Math.abs(this.vx)),-.55,.55),pulse=1+Math.